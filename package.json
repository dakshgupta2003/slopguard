{
  "name": "@daksh_dev_2003/slopguard",
  "version": "0.1.2",
  "description": "Blocks AI-hallucinated and slopsquatted packages before they install.",
  "license": "MIT",
  "author": "Daksh Gupta",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dakshgupta2003/slopguard.git"
  },
  "bugs": {
    "url": "https://github.com/dakshgupta2003/slopguard/issues"
  },
  "homepage": "https://github.com/dakshgupta2003/slopguard#readme",
  "type": "module",
  "bin": {
    "slopguard": "dist/cli.js"
  },
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "node --eval \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc && node --eval \"require('node:fs').cpSync('src/data','dist/data',{recursive:true})\"",
    "test": "node --import tsx --test test/*.test.ts",
    "prepare": "npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.4.3"
  },
  "files": [
    "dist",
    "THIRD-PARTY.md"
  ],
  "keywords": [
    "slopsquatting",
    "typosquatting",
    "supply-chain-security",
    "mcp",
    "ai-agents"
  ]
}
